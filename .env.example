# Daily Bronze and the public Vercel export need no credentials.
# Names only: store production values in GitHub Actions repository Secrets.
# A local .env is gitignored; the CLIs read process environment variables and
# do not automatically load .env files.

# Required by gateway fetch --source openrouter (historical rankings dataset).
# OPENROUTER_API_KEY=

# Optional experimental Replicate spike.
# REPLICATE_API_TOKEN=

# Optional bounded Cloudflare Radar spike (outside regular core collection).
# CLOUDFLARE_API_TOKEN=
